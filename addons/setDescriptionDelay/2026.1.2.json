{
	"addonId": "setDescriptionDelay",
	"displayName": "Set Character Description Delay",
	"URL": "https://github.com/Surveyor123/setDescriptionDelay/releases/download/v2026.1.2/setDescriptionDelay-2026.1.2.nvda-addon",
	"description": "This add-on improves NVDA's delayed character description feature:\n\tAllows you to configure the announcement delay in milliseconds, offering more flexibility than the built-in option.\n\tWhen the delay is set to 0, the character description is announced immediately instead of the character itself.\n\tThe add-on is controlled entirely through NVDA's existing \"Delayed descriptions for characters on cursor movement\" checkbox in Voice settings.",
	"sha256": "77a2f57c155623fb173e84069bbeb98c1b33d4c591de6beea43374f9e9a9e57c",
	"addonVersionName": "2026.1.2",
