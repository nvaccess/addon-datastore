	"translations": [
		{
			"language": "zh_CN",
			"displayName": "窗口状态",
			"description": "新增一个命令，用于读出当前前台窗口的状态（最大化、还原、最小化，或贴靠到屏幕的一侧或四分之一）。可选择将窗口状态附加到 NVDA+T 快捷键，类似于 JAWS 的行为。帮助盲人用户在不触发 Windows 贴靠布局选择器的情况下，确认窗口是否已最大化。",
			"changelog": "Added detection of Windows 11 Snap Layout thirds (left, middle, and right thirds, plus the two-thirds combinations). Added an optional setting to report which display a window is on, matching JAWS behavior for multiple monitors."
		},
		{
			"language": "kmr",
			"displayName": "Rewşa Paceyê",
			"description": "Fermanekê lê zêde dike da ku rewşa pencereya pêşiyê ya heyî ragihîne (mezintirîn, vegerandin, kêmkirin, an jî li aliyek an çaryeka ekranê hatî kişandin). Bi awayekî vebijarkî rewşa pencereyê li NVDA+T zêde dike mîna ku JAWS dike. Alîkariya bikarhênerên kor dike ku piştrast bikin ka pencereyek bêyî çalakkirina hilbijêra sêwirana snap-a Windows-ê herî zêde ye.",
			"changelog": "Added detection of Windows 11 Snap Layout thirds (left, middle, and right thirds, plus the two-thirds combinations). Added an optional setting to report which display a window is on, matching JAWS behavior for multiple monitors."
		},
		{
			"language": "tr",
			"displayName": "Pencere Durumu",
			"description": "Geçerli ön plandaki pencerenin durumunu (büyütülmüş, geri yüklenmiş, küçültülmüş veya ekranın bir kenarına ya da dörtte birine yapıştırılmış) seslendiren bir komut ekler. İsteğe bağlı olarak, JAWS’ın yaptığı gibi pencere durumunu NVDA+T’ye ekler. Görme engelli kullanıcıların, Windows’un yapıştırma düzeni seçicisini tetiklemeden bir pencerenin büyütülmüş olup olmadığını doğrulamasına yardımcı olur.",
			"changelog": "Added detection of Windows 11 Snap Layout thirds (left, middle, and right thirds, plus the two-thirds combinations). Added an optional setting to report which display a window is on, matching JAWS behavior for multiple monitors."
		}
	],
