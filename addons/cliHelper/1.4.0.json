	"addonId": "cliHelper",
	"displayName": "CLI Helper",
	"URL": "https://github.com/Naeem-hashmi/Nvidia-c-l-i-helper-/releases/download/v1.4.0/cliHelper-1.4.0.nvda-addon",
	"description": "Makes Command Prompt, PowerShell, Windows Terminal, WSL and other consoles easier to use.\nSpeaks interactive prompts (selection lists, checkboxes and yes/no toggles such as create-next-app),\nreads the last command's output, announces when long commands finish, and adds a\nCLI mode with word-processor style reading, selection and copying. Press NVDA+Alt+C, then H for help.",
	"sha256": "d24f585b3fd2403f7d1b4c4066615afce0501c3d95a4dcbd07aa2ac18454b297",
