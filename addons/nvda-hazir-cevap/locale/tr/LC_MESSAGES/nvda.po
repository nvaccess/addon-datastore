#. Add-on summary / Script category
msgid "Quick Response"
msgstr "Hazır Cevap"

#. Add-on description in manifest
msgid "Save an unlimited number of texts and quickly paste them with assigned keyboard shortcuts."
msgstr "Sınırsız sayıda metni kaydedin ve atadığınız klavye kısayollarıyla hızlıca yapıştırın."

msgid "Entries could not be saved"
msgstr "Kayıtlar kaydedilemedi"

msgid "Quick response"
msgstr "Hazır cevap"

msgid "&Name:"
msgstr "&Ad:"

msgid "&Text:"
msgstr "&Metin:"

msgid "&Shortcut (e.g. kb:NVDA+control+1, can be left blank):"
msgstr "&Kısayol (örn. kb:NVDA+control+1, boş bırakılabilir):"

msgid "Text cannot be empty."
msgstr "Metin boş olamaz."

msgid "Error"
msgstr "Hata"

msgid "Quick Response Manager"
msgstr "Hazır Cevap Yöneticisi"

msgid "&Saved responses:"
msgstr "&Kayıtlı cevaplar:"

msgid "&Add..."
msgstr "&Ekle..."

msgid "&Edit..."
msgstr "&Düzenle..."

msgid "&Delete"
msgstr "&Sil"

msgid "&Paste"
msgstr "&Yapıştır"

msgid "Delete selected response?"
msgstr "Seçili cevap silinsin mi?"

msgid "Confirmation"
msgstr "Onay"

msgid "Failed to copy to clipboard"
msgstr "Panoya kopyalanamadı"

msgid "Failed to paste"
msgstr "Yapıştırılamadı"

msgid "Opens the quick response manager"
msgstr "Hazır cevap yöneticisini açar"

msgid "Selects and pastes from the quick response list"
msgstr "Hazır cevap listesinden seçip yapıştırır"

msgid "No saved quick responses"
msgstr "Kayıtlı hazır cevap yok"

msgid "Select response to paste"
msgstr "Yapıştırılacak cevabı seçin"
