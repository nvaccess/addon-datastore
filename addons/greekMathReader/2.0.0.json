{
	"addonId": "greekMathReader",
	"displayName": "Greek Math Reader",
	"URL": "https://github.com/ChristosBouronikos/NVDA-Greek-Math/releases/download/v2.0.0/greekMathReader-2.0.0.nvda-addon",
	"description": "Reads mathematical content (MathML) aloud in natural Greek, following the dictation\nconventions used in Greek schools and universities.\nSupports school and university mathematics, statistics, SI physics units, fractions,\npowers, roots, integrals, limits, derivatives, matrices, probability, and LaTeX input.\nIncludes interactive navigation to explore complex expressions part by part,\nand three verbosity levels (terse, smart, verbose).",
	"sha256": "1bbb879176ca68a6ededb4164198677d1489a70600f8d9eb3b18910f5d8b76e1",
